# Environment configuration for GranthSetu - Abhyasika Management System

# 1. Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/granthsetu_abhyasika?schema=public"

# 2. NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="granthsetu_super_secret_jwt_key_change_in_production"

# 3. Razorpay Integration (Live keys stored in server env only)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# 4. SMS / WhatsApp Provider (MSG91 / Fast2SMS / Meta Cloud API)
SMS_AUTH_KEY=""
SMS_SENDER_ID=""
SMS_DLT_TE_ID_ADMISSION=""
SMS_DLT_TE_ID_FEES_DUE=""
SMS_DLT_TE_ID_FEES_PAID=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# 5. Aadhaar eKYC Provider (Digio / Setu / Signzy)
AADHAAR_PROVIDER="DIGIO"
AADHAAR_CLIENT_ID=""
AADHAAR_CLIENT_SECRET=""

# 6. Storage (AWS S3 or MinIO for photos, ID cards, receipts)
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
